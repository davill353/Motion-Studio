      "parameters": {
        "jsCode": "const j = $input.first().json;\nif (!j.refresh_token) throw new Error('TikTok did not return a token: ' + JSON.stringify(j.error || j).slice(0, 300));\nreturn [{ json: { name: 'tiktok', refresh_token: j.refresh_token, open_id: j.open_id, scope: j.scope,\n  updated_at: DateTime.now().setZone('Europe/London').toFormat('yyyy-MM-dd HH:mm') } }];"
      },
